# Create .env.local and add your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_api_key

# Optional override. Defaults to the current stable Flash model.
GEMINI_MODEL=gemini-3.8-flash

# ESPN fantasy league. SWID and espn_s2 are the cookies from fantasy.espn.com.
ESPN_LEAGUE_ID=your_league_id
ESPN_YEAR=2027
ESPN_SWID="{YOUR-SWID}"
ESPN_S2=your_espn_s2_cookie
